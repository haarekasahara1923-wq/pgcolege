generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model College {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  description   String
  imageUrl      String?
  imagePublicId String?
  address       String?
  order         Int       @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  courses       Course[]
  enquiries     Enquiry[]

  @@index([slug])
  @@index([order])
  @@index([isActive])
}

model Course {
  id          String    @id @default(cuid())
  collegeId   String
  college     College   @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  name        String
  duration    String
  description String?
  eligibility String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  enquiries   Enquiry[]

  @@index([collegeId])
  @@index([order])
}

model AboutContent {
  id                String    @id @default(cuid())
  title             String    @default("About Us")
  description       String    @default("")
  vision            String    @default("")
  mission           String    @default("")
  imageUrl          String?
  imagePublicId     String?
  directorName      String?
  directorMessage   String?
  directorImageUrl  String?
  directorImageId   String?
  principalName     String?
  principalMessage  String?
  principalImageUrl String?
  principalImageId  String?
  updatedAt         DateTime  @updatedAt
}

model ContactDetails {
  id               String   @id @default(cuid())
  address          String   @default("")
  phones           String[] @default([])
  emails           String[] @default([])
  whatsappNumber   String?
  whatsappGreeting String   @default("Hello Prathvi Group of College, I would like to know more about your courses.")
  workingHours     String   @default("")
  mapEmbedUrl      String?
  facebook         String?
  instagram        String?
  youtube          String?
  twitter          String?
  linkedin         String?
  logoUrl          String?
  logoPublicId     String?
  updatedAt        DateTime @updatedAt
}

enum GalleryType {
  IMAGE
  VIDEO
}

model GalleryItem {
  id         String      @id @default(cuid())
  type       GalleryType @default(IMAGE)
  url        String
  publicId   String?
  youtubeUrl String?
  title      String?
  category   String?
  order      Int         @default(0)
  createdAt  DateTime    @default(now())

  @@index([type])
  @@index([order])
  @@index([createdAt])
}

enum EnquirySource {
  FORM
  WHATSAPP
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

model Enquiry {
  id          String        @id @default(cuid())
  name        String
  phone       String
  email       String?
  collegeId   String?
  college     College?      @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  courseId    String?
  course      Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)
  collegeName String?
  courseName  String?
  message     String
  source      EnquirySource @default(FORM)
  status      EnquiryStatus @default(NEW)
  adminNote   String?
  ipAddress   String?
  createdAt   DateTime      @default(now())

  @@index([status])
  @@index([source])
  @@index([createdAt])
  @@index([collegeId])
  @@index([courseId])
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Affiliate {
  id              String    @id @default(cuid())
  name            String
  resAddress      String
  officeAddress   String
  mobileNo        String    @unique
  whatsappNo      String
  email           String    @unique
  workingArea     String
  courses         String
  
  // Profile completion fields
  businessName    String?
  photoUrl        String?
  bankAccountNo   String?
  ifscCode        String?
  aadharCardUrl   String?
  panCardUrl      String?
  cancelCheckUrl  String?
  
  // Admin managed fields
  isApproved      Boolean   @default(false)
  isBlocked       Boolean   @default(false)
  commissionRate  String?
  affiliateCode   String    @unique
  
  // Relations
  students        Student[]
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([affiliateCode])
}

model Student {
  id                      String    @id @default(cuid())
  name                    String
  courseInterested        String
  mobileNo                String
  whatsappNo              String
  
  // Optional Govt IDs
  aadharCardUrl           String?
  panCardUrl              String?
  aparIdUrl               String?
  samagraIdUrl            String?
  casteCertificateUrl     String?
  
  // Optional Academic Records
  tenthMarksheetUrl       String?
  twelfthMarksheetUrl     String?
  graduationMarksheetUrl  String?
  
  // Passport photo
  photoUrl                String?
  
  // Status and Affiliate relation
  affiliateId             String
  affiliate               Affiliate @relation(fields: [affiliateId], references: [id])
  
  // Admin managed fields
  admissionStatus         String    @default("PENDING") // PENDING, APPROVED, REJECTED
  commissionPaid          Boolean   @default(false)
  paymentProofUrl         String?
  
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([affiliateId])
}
